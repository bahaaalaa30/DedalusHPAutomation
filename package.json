{
  "name": "dedalus-hp-playwright",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:api": "playwright test src/tests/performance/login-api.spec.ts",
    "test:suite": "node scripts/run-suite.js",
    "test:suite:headed": "node scripts/run-suite.js --headed",
    "typecheck": "tsc --noEmit",
    "report": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report"
  },
  "dependencies": {
    "dotenv": "^17.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "allure-commandline": "^2.36.0",
    "allure-playwright": "^3.4.1",
    "typescript": "^5.9.2"
  }
}
