{
  "name": "dedalus-hp-playwright",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:api": "playwright test src/tests/performance/login-api.spec.ts",
    "test:suite": "node scripts/run-suite.js",
    "test:suite:headed": "node scripts/run-suite.js --headed",
    "typecheck": "tsc --noEmit",
    "report": "allure generate allure-results/normal-cases --clean -o allure-report/normal-cases",
    "report:open": "allure open allure-report/normal-cases",
    "test:suite:normal": "node scripts/run-suite.js --suite=normal-cases",
    "test:suite:normal:headed": "node scripts/run-suite.js --suite=normal-cases --headed",
    "test:suite:payer": "node scripts/run-suite.js --suite=payer-integration",
    "test:suite:payer:headed": "node scripts/run-suite.js --suite=payer-integration --headed",
    "report:payer": "allure generate allure-results/payer-integration --clean -o allure-report/payer-integration",
    "report:payer:open": "allure open allure-report/payer-integration"
  },
  "dependencies": {
    "dotenv": "^17.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "allure-commandline": "^2.36.0",
    "allure-playwright": "^3.4.1",
    "typescript": "^5.9.2"
  }
}
